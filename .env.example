# Copia este archivo como .env y coloca tus credenciales reales
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-1-<region>.pooler.supabase.com:5432/postgres
DB_SSLMODE=require
DB_CONN_MAX_AGE=600

# Integracion con Node-RED (Render)
NODERED_BASE_URL=https://node-red-suelo.onrender.com
# Reservado: Node-RED aun no implementa autenticacion compatible.
NODERED_API_TOKEN=
NODERED_TIMEOUT=5

# Sesion cross-origin (frontend en Vercel)
# SESSION_COOKIE_SECURE=True
# SESSION_COOKIE_SAMESITE=None
