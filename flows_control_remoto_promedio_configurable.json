    {
        "id": "fn_motor",
        "type": "function",
        "z": "flow_suelo",
        "name": "Encender bomba y responder",
        "func": "// Enciende la bomba y responde de inmediato. El apagado se programa\n// 5 segundos despues con el nodo delay.\nconst duracion = Number(msg.payload && msg.payload.duracion);\nconst segundos = Number.isFinite(duracion) && duracion > 0 && duracion <= 60 ? duracion : 5;\n\nconst commandMsg = {\n    topic: 'esp32/suelo/bomba/control',\n    payload: 'ON',\n    qos: 1,\n    retain: false,\n    delay: segundos * 1000\n};\n\nconst responseMsg = {\n    res: msg.res,\n    statusCode: 200,\n    headers: { 'Content-Type': 'application/json' },\n    payload: { status: 'ok', bomba: 'encendida', duracion: segundos }\n};\n\nreturn [commandMsg, responseMsg];",
        "outputs": 2,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 430,
        "y": 800,
        "wires": [
            [
                "mqtt_control_out",
                "delay_motor_off"
            ],
            [
                "http_motor_out"
            ]
        ]
    },
