    {
        "id": "fn_promedio_diario",
        "type": "function",
        "z": "flow_suelo",
        "name": "Calcular promedio diario",
        "func": "// Promedio solo del día actual en hora Colombia (America/Bogota).\n// La columna \"timestamp\" es timestamp WITH time zone.\n// Se borra el registro de hoy para no duplicar si se ejecuta dos veces.\nconst hoy = \"(NOW() AT TIME ZONE 'America/Bogota')::date\";\n\nmsg.query = `\nDELETE FROM promedio_diario\nWHERE fecha = ${hoy};\n\nINSERT INTO promedio_diario (humedad_promedio, fecha)\nSELECT AVG(humedad), ${hoy}\nFROM humedad\nWHERE (\"timestamp\" AT TIME ZONE 'America/Bogota')::date = ${hoy}\nHAVING AVG(humedad) IS NOT NULL;\n`;\n\nmsg.params = [];\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 440,
        "y": 400,
        "wires": [
            [
                "pg_promedio"
            ]
        ]
    },
