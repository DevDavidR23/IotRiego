    {
        "id": "fn_control_mqtt",
        "type": "function",
        "z": "flow_suelo",
        "name": "Validar comando y preparar MQTT",
        "func": "// Django envia JSON: {\"dispositivo\":\"bomba\",\"estado\":\"ON\"}\n// dispositivo: bomba | sensor. estado: ON | OFF.\nconst body = msg.payload;\nconst dispositivo = body && typeof body.dispositivo === 'string' ? body.dispositivo.toLowerCase() : '';\nconst estado = body && typeof body.estado === 'string' ? body.estado.toUpperCase() : '';\n\nif (![\"bomba\", \"sensor\"].includes(dispositivo) || ![\"ON\", \"OFF\"].includes(estado)) {\n    msg.statusCode = 400;\n    msg.headers = { 'Content-Type': 'application/json' };\n    msg.payload = { ok: false, error: 'Solicitud inválida. Use dispositivo=bomba|sensor y estado=ON|OFF.' };\n    return [null, msg];\n}\n\n// Topicos de comando separados de los topicos de telemetria/estado.\nconst mqttMsg = {\n    topic: 'esp32/suelo/' + dispositivo + '/control',\n    payload: estado,\n    qos: 1,\n    retain: false\n};\n\nconst responseMsg = { ...msg };\nresponseMsg.statusCode = 200;\nresponseMsg.headers = { 'Content-Type': 'application/json' };\nresponseMsg.payload = {\n    ok: true,\n    mensaje: 'Comando aceptado por Node-RED; publicación MQTT solicitada',\n    dispositivo: dispositivo,\n    estado: estado,\n    topic: mqttMsg.topic\n};\nreturn [mqttMsg, responseMsg];",
        "outputs": 2,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 440,
        "y": 700,
        "wires": [
            [
                "mqtt_control_out"
            ],
            [
                "http_control_out"
            ]
        ]
    },
