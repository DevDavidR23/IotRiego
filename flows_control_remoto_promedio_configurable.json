    {
        "id": "fn_sensor_leer",
        "type": "function",
        "z": "flow_suelo",
        "name": "Pedir lectura con request_id",
        "func": "// HTTP se queda esperando la respuesta MQTT del ESP32. Se guarda msg.res\n// y un temporizador para responder 504 si el sensor no contesta.\nconst requestId = RED.util.generateId().replace(/\\./g, '');\nconst timeoutMs = 10000;\n\nconst pending = {\n    res: msg.res,\n    timer: setTimeout(function () {\n        const current = flow.get('sensor_read_' + requestId);\n        if (!current) return;\n        flow.set('sensor_read_' + requestId, null);\n        node.send([null, {\n            res: current.res,\n            statusCode: 504,\n            headers: { 'Content-Type': 'application/json' },\n            payload: { status: 'error', error: 'sensor_timeout', request_id: requestId }\n        }]);\n    }, timeoutMs)\n};\nflow.set('sensor_read_' + requestId, pending);\n\nreturn [{\n    topic: 'esp32/suelo/sensor/leer',\n    payload: JSON.stringify({ request_id: requestId }),\n    qos: 1,\n    retain: false\n}, null];",
        "outputs": 2,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 420,
        "y": 920,
        "wires": [
            [
                "mqtt_control_out"
            ],
            [
                "http_sensor_out"
            ]
        ]
    },
    {
        "id": "fn_resolver_sensor",
        "type": "function",
        "z": "flow_suelo",
        "name": "Resolver lectura del sensor",
        "func": "// Solo actua si el dato trae request_id (lectura solicitada por HTTP).\n// Las lecturas periodicas sin request_id se insertan en Supabase como siempre.\nconst payload = msg.payload;\nif (!payload || typeof payload !== 'object' || !payload.request_id) {\n    return null;\n}\n\nconst key = 'sensor_read_' + payload.request_id;\nconst pending = flow.get(key);\nif (!pending) {\n    return null;\n}\n\nclearTimeout(pending.timer);\nflow.set(key, null);\n\nconst humedad = Number(payload.humedad);\nif (!Number.isFinite(humedad)) {\n    return {\n        res: pending.res,\n        statusCode: 502,\n        headers: { 'Content-Type': 'application/json' },\n        payload: { status: 'error', error: 'sensor_data_invalid', request_id: payload.request_id }\n    };\n}\n\nreturn {\n    res: pending.res,\n    statusCode: 200,\n    headers: { 'Content-Type': 'application/json' },\n    payload: {\n        status: 'ok',\n        humedad: humedad,\n        timestamp: payload.timestamp || new Date().toISOString(),\n        request_id: payload.request_id\n    }\n};",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 430,
        "y": 200,
        "wires": [
            [
                "http_sensor_out"
            ]
        ]
    },
